# ============================================================================
# ora_sync - configuration des connexions Oracle
#
# Copier ce fichier en `.env` puis renseigner les mots de passe :
#     cp .env.example .env
#
# L'outil lit ce fichier automatiquement (setup_project.py), sans jamais
# ecraser une variable deja presente dans l'environnement du shell.
# ============================================================================

# --- Connexion commune -------------------------------------------------------
# DSN au format Easy Connect : <hote>:<port>/<service>
# Peut etre surcharge par profil via ORASYNC_<PROFIL>_DSN.
ORASYNC_DSN=localhost:1521/FREEPDB1

# --- Profils de connexion ----------------------------------------------------
# Profils disponibles par defaut : admin, schema_a, schema_b, sys
# (personnalisable via ORASYNC_PROFILES=admin,schema_a,schema_b,sys)
#
# Pour chaque profil <P> : ORASYNC_<P>_USER, ORASYNC_<P>_PASSWORD,
#                          ORASYNC_<P>_DSN (optionnel), ORASYNC_<P>_ROLE (optionnel)

ORASYNC_ADMIN_USER=SYNC_ADMIN
ORASYNC_ADMIN_PASSWORD=change_me

ORASYNC_SCHEMA_A_USER=SCHEMA_A
ORASYNC_SCHEMA_A_PASSWORD=change_me

ORASYNC_SCHEMA_B_USER=SCHEMA_B
ORASYNC_SCHEMA_B_PASSWORD=change_me

# SYS est optionnel : utilise uniquement pour des grants systeme (DBMS_CRYPTO...).
# Attention : le role SYSDBA peut necessiter python-oracledb en mode thick.
ORASYNC_SYS_USER=SYS
ORASYNC_SYS_PASSWORD=change_me
ORASYNC_SYS_ROLE=SYSDBA

# --- Database link utilise pour les tests multi-schemas ----------------------
# Nom du lien public cree dans le script 05, et utilisateur avec lequel il
# se connecte (sert a substituer <UTILISATEUR_UTILISE_PAR_SYNC_LINK_B>).
ORASYNC_LINK_NAME=SYNC_LINK_B
ORASYNC_LINK_USER=SYNC_ADMIN

# --- Options (facultatives) --------------------------------------------------
# ORASYNC_PROFILES=admin,schema_a,schema_b,sys
# ORASYNC_ENV_FILE=.env
# ORASYNC_VENV=.venv
# ORASYNC_SCRIPTS_DIR=.
# ORASYNC_LOG_FILE=.orasync/orasync.log
